{
    "name": "eburonmedia/ecma-core",
    "description": ":package_description",
    "license": "UNLICENSED",
    "authors": [
        {
            "name": "Maikel Zwart",
            "email": "maikel@eburon.media",
            "homepage": "https://eburon.media"
        }
    ],
    "homepage": "https://github.com/eburonmedia/ecma-core",
    "keywords": ["Laravel", "EcmaCore"],
    "require": {
        "illuminate/support": "~7",
        "doctrine/dbal": "^2.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0",
        "mockery/mockery": "^1.1",
        "orchestra/testbench": "~3|~4",
        "sempro/phpunit-pretty-print": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "EburonMedia\\EcmaCore\\": "src/"
        },
        "files": [
            "src/Http/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "EburonMedia\\EcmaCore\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EburonMedia\\EcmaCore\\EcmaCoreServiceProvider"
            ],
            "aliases": {
                "EcmaCore": "EburonMedia\\EcmaCore\\Facades\\EcmaCore"
            }
        }
    }
}
